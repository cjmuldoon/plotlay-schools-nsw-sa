	column nsw_only_ram_per_student_2024
		dataType: double
		formatString: $#,0
		lineageTag: 308d93cc-f101-a445-fa3a-86290b4e8718
		summarizeBy: none
		sourceColumn: nsw_only_ram_per_student_2024

		annotation SummarizationSetBy = Automatic

	partition Schools = m
		mode: import
		source =
				let
				    TypedSource = Csv.Document(GetFile("comparison/07_inner_city_schools.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    TypedPromoted = Table.PromoteHeaders(TypedSource, [PromoteAllScalars = true]),
				    TypedKept = Table.SelectColumns(TypedPromoted, {"school_key", "school_name", "state", "city", "level", "count_basis", "suburb", "km_from_centre", "grade", "flag", "in_comparison", "outline_from", "outline_note", "area_m2", "students_2019", "students_2024", "m2_per_student_2024"}),
				    Typed = Table.TransformColumnTypes(TypedKept, {{"school_key", type text}, {"school_name", type text}, {"state", type text}, {"city", type text}, {"level", type text}, {"count_basis", type text}, {"suburb", type text}, {"km_from_centre", type number}, {"grade", type text}, {"flag", type text}, {"in_comparison", type logical}, {"outline_from", type text}, {"outline_note", type text}, {"area_m2", type number}, {"students_2019", type number}, {"students_2024", type number}, {"m2_per_student_2024", type number}}, "en-AU"),
				    Keyed = Table.AddColumn(Typed, "school_id", each [state] & "-" & [school_key], type text),
				    Banded = Table.AddColumn(Keyed, "m2_band_2024", each let v = [m2_per_student_2024] in if not [in_comparison] or v = null then "5 not compared" else if v < 15 then "1 under 15" else if v < 30 then "2 15 to 30" else if v < 60 then "3 30 to 60" else "4 60 or more", type text),
				    Labelled = Table.AddColumn(Banded, "m2_band_label", each Text.Middle([m2_band_2024], 2), type text),
				    NswSource = Csv.Document(GetFile("nsw/07_inner_city_schools.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    NswPromoted = Table.PromoteHeaders(NswSource, [PromoteAllScalars = true]),
				    NswKept = Table.SelectColumns(NswPromoted, {"school_key", "nsw_only_icsea", "nsw_only_ram_per_student_2024"}),
				    Nsw = Table.TransformColumnTypes(NswKept, {{"school_key", type text}, {"nsw_only_icsea", type number}, {"nsw_only_ram_per_student_2024", type number}}, "en-AU"),
				    NswKeyed = Table.AddColumn(Nsw, "nsw_id", each "NSW-" & [school_key], type text),
				    Joined = Table.NestedJoin(Labelled, {"school_id"}, NswKeyed, {"nsw_id"}, "nsw", JoinKind.LeftOuter),
				    Expanded = Table.ExpandTableColumn(Joined, "nsw", {"nsw_only_icsea", "nsw_only_ram_per_student_2024"}),
				    Out = Table.TransformColumnTypes(Expanded, {{"nsw_only_icsea", type number}, {"nsw_only_ram_per_student_2024", type number}}, "en-AU")
				in
				    Out

	annotation PBI_ResultType = Table


model Model
	culture: en-AU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","GetFile","States","Schools","Enrolments","Years","Spend","Outcomes","NAPLAN"]
annotation __PBI_TimeIntelligenceEnabled = 0

ref table States
ref table Schools
ref table Enrolments
ref table Years
ref table Spend
ref table Outcomes
ref table NAPLAN

ref cultureInfo en-AU

model Model
	culture: en-AU
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-AU
	dataAccessOptions
		fastCombine
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder","GetFile","States","Schools","Enrolments","Years","Spend","Outcomes","NAPLAN"]

annotation PBI_ProTooling = ["DevMode"]

ref table States
ref table Schools
ref table Enrolments
ref table Years
ref table Spend
ref table Outcomes
ref table NAPLAN

ref cultureInfo en-AU

